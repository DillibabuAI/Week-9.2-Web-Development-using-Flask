<!DOCTYPE html>
<html>
    <head>
        <title>CKD Prediction</title>
    </head>
    <body>
        <h2>Chronic Kidney Disease Prediction</h2>
        <form action="/predict" method="post">
            <label for="bgr">Blood Glucose Random</label>
            <input type="number" id="bgr" name="bgr" step="any" required><br><br>

            <label for="bu">Blood Urea</label>
            <input type="number" id="bu" name="bu" step="any" required><br><br>

            <label for="sc">Serum Creatinine</label>
            <input type="number" id="sc" name="sc" step="any" required><br><br>

            <label for="pcv">PCV:</label>
            <input type="number" id="pcv" name="pcv" step="any" required><br><br>

            <label for="wc">WC:</label>
            <input type="number" id="wc" name="wc" step="any" required><br><br>

            <input type="submit" value="Predict">
        </form>
    </body>
</html>